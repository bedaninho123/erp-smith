# Copie este arquivo para ".env" (sem ".example") e cole sua chave real lá.
# O ".env" nunca vai pro Git (está no .gitignore) -- só este exemplo, sem
# nenhuma chave de verdade, fica versionado.

OPENAI_API_KEY=

# API de Parceiros do Shooting House (habitualidade, atirador, arma).
# Enquanto vazio, o sistema usa dado simulado automaticamente.
SHOOTING_HOUSE_USER=
SHOOTING_HOUSE_PASSWORD=

# De qual empresa (multi-tenant) e o e-mail que entra pelo poller e pelo
# webhook. Enquanto o sistema vigia uma caixa do Gmail so, esta e a
# empresa dona dela. Vazio = EMP-000001 (a Smith).
ERP_EMPRESA_ID=

# Segredo compartilhado que o endpoint /webhook/mensagem exige no
# cabecalho X-Webhook-Secret. Enquanto vazio, o endpoint aceita
# qualquer chamada (ok para desenvolvimento local, nao para produção).
WEBHOOK_SECRET=

# Para onde mandar e-mail de alerta quando o poller/webhook falhar
# (ver atendimento/alertas.py). Recomendado: seu proprio e-mail.
# Enquanto vazio, alertas ficam so no log local.
ALERTA_EMAIL=

# Chave interna que protege o cookie de sessao do painel administrativo
# (webapp/). Nao e uma senha sua -- e gerada automaticamente na primeira
# vez que o painel roda (ver webapp/app.py) e salva aqui sozinha. So
# precisa mexer nisso se quiser forcar todo mundo a logar de novo.
WEBAPP_SECRET_KEY=

# Mesma ideia do WEBAPP_SECRET_KEY, so que pro Portal do Cliente
# (portal/), gerada sozinha na primeira vez que o portal roda.
PORTAL_SECRET_KEY=

# Endereco base usado para montar o link magico de login do Portal do
# Cliente (ver portal/app.py). Padrao e http://127.0.0.1:5002 (uso
# local); trocar quando o Portal for hospedado de verdade em produção.
PORTAL_URL_BASE=

# De qual empresa (multi-tenant) e este Portal. Usado so na tela de
# login, antes de existir sessao -- depois de logado a empresa vem do
# proprio cliente. Vazio = EMP-000001 (a Smith).
PORTAL_EMPRESA_ID=

# Sim/vazio -- controla se o cookie de sessao do painel e do Portal so
# trafega em HTTPS (SESSION_COOKIE_SECURE). Deixe vazio enquanto os dois
# rodarem em HTTP puro (127.0.0.1) -- ligar sem HTTPS de verdade na
# frente quebra o login, porque o navegador nao manda o cookie de volta.
# So colocar "Sim" quando houver HTTPS real na frente dos dois apps.
COOKIE_HTTPS=

# Pasta onde core/db/backup.py grava o backup diario (banco + documentos
# recebidos). Vazio = uma pasta "backups/" dentro do proprio projeto, no
# MESMO disco -- protege contra exclusao/corrupcao acidental do arquivo
# em uso, mas nao contra falha fisica do disco. Para backup de verdade,
# aponte para um local fora desta maquina (pasta sincronizada com nuvem,
# unidade de rede, HD externo).
BACKUP_DIR=

# Quantos backups diarios manter antes de apagar o mais antigo. Vazio =
# 14 (duas semanas).
BACKUP_MANTER_ULTIMOS=
