# Copie este arquivo para ".env" (sem ".example") e cole sua chave real lá.
# O ".env" nunca vai pro Git (está no .gitignore) -- só este exemplo, sem
# nenhuma chave de verdade, fica versionado.

OPENAI_API_KEY=

# API de Parceiros do Shooting House (habitualidade, atirador, arma).
# Enquanto vazio, o sistema usa dado simulado automaticamente.
SHOOTING_HOUSE_USER=
SHOOTING_HOUSE_PASSWORD=

# CHAVE GERAL do modo real, separada da credencial DE PROPOSITO.
# Preencher usuario e senha acima NAO liga nada sozinho -- o sistema so
# comeca a consultar dado de pessoa de verdade quando esta variavel
# estiver com "Sim". Serve pra duas coisas:
#   1. guardar a credencial e conferir a resposta com o diagnostico
#      (integracoes/diagnostico_shooting_house.py) ANTES de o poller,
#      que roda a cada 2 min, comecar a atender cliente com dado real;
#   2. botao de panico -- deu problema, apaga o "Sim" daqui e tudo volta
#      pro simulado na hora, sem apagar credencial nem mexer em codigo.
SHOOTING_HOUSE_ATIVO=

# Endereco base da API. Vazio = https://apibeta.shootinghouse.com.br/v1/partners
# (ambiente BETA/homologacao do fornecedor). Ao receber credencial de
# PRODUCAO, o endereco muda -- conferir com o Shooting House e trocar
# aqui. Precisa comecar com https:// : a autenticacao e Basic Auth, ou
# seja, usuario e senha viajam em toda chamada, e sem HTTPS vao em texto
# claro. O sistema recusa subir em http://.
SHOOTING_HOUSE_BASE_URL=

# WhatsApp Business Cloud API (Meta). Enquanto TOKEN e PHONE_NUMBER_ID
# estiverem vazios, o sistema NAO manda nada: grava o que teria sido
# enviado em integracoes/whatsapp_simulado.log e o painel avisa em cima
# da tela de Atendimentos que esta simulado.
#
# ANTES DE PREENCHER, entenda o custo: o aplicativo "WhatsApp Business"
# do celular NAO tem API. Para o sistema mandar mensagem, o numero
# precisa ser migrado para a Cloud API -- e ao migrar ele SAI do
# aplicativo. Nao da pra ter os dois no mesmo numero. Alem disso, a Meta
# so entrega mensagem recebida num endereco HTTPS publico, o que exige
# resolver a hospedagem antes (hoje tudo roda em localhost).
#
# Onde achar cada valor: painel do app em developers.facebook.com.
# TOKEN e PHONE_NUMBER_ID ficam em WhatsApp > Configuracao da API;
# VERIFY_TOKEN e uma senha que VOCE inventa e repete no cadastro do
# webhook; APP_SECRET fica em Configuracoes basicas do app.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Versao da API Graph usada nas chamadas. Vazio = v21.0.
WHATSAPP_API_VERSION=

# De qual empresa (multi-tenant) e o e-mail que entra pelo poller e pelo
# webhook. Enquanto o sistema vigia uma caixa do Gmail so, esta e a
# empresa dona dela. Vazio = EMP-000001 (a Smith).
ERP_EMPRESA_ID=

# Segredo compartilhado que o endpoint /webhook/mensagem exige no
# cabecalho X-Webhook-Secret. Enquanto vazio, o endpoint aceita
# qualquer chamada (ok para desenvolvimento local, nao para produção).
WEBHOOK_SECRET=

# Para onde mandar e-mail de alerta quando o poller/webhook falhar
# (ver atendimento/alertas.py). Recomendado: seu proprio e-mail.
# Enquanto vazio, alertas ficam so no log local.
ALERTA_EMAIL=

# Chave interna que protege o cookie de sessao do painel administrativo
# (webapp/). Nao e uma senha sua -- e gerada automaticamente na primeira
# vez que o painel roda (ver webapp/app.py) e salva aqui sozinha. So
# precisa mexer nisso se quiser forcar todo mundo a logar de novo.
WEBAPP_SECRET_KEY=

# Mesma ideia do WEBAPP_SECRET_KEY, so que pro Portal do Cliente
# (portal/), gerada sozinha na primeira vez que o portal roda.
PORTAL_SECRET_KEY=

# Chave que CIFRA a senha do gov.br dos clientes (core/motor_credenciais.py).
# Sem ela, o painel recusa guardar e mostrar senha. NAO e gerada sozinha:
# perder esta chave e perder TODAS as senhas guardadas, e um backup do
# banco so pode ser lido com ela -- guarde uma copia fora do servidor.
# Gerar: .venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ERP_CHAVE_SENHAS=

# Endereco base usado para montar o link magico de login do Portal do
# Cliente (ver portal/app.py). Padrao e http://127.0.0.1:5002 (uso
# local); trocar quando o Portal for hospedado de verdade em produção.
PORTAL_URL_BASE=

# Só em produção (webapp/servir.py): o endereço de cada app quando eles
# têm subdomínio próprio, sem https:// e sem barra. Ex.:
#   PORTAL_HOST=portal.smithclubedetiro.com.br
#   PAINEL_HOST=painel.smithclubedetiro.com.br
# Vazias = painel e Portal dividem um endereço, separados pelo /portal.
PORTAL_HOST=
PAINEL_HOST=

# De qual empresa (multi-tenant) e este Portal. Usado so na tela de
# login, antes de existir sessao -- depois de logado a empresa vem do
# proprio cliente. Vazio = EMP-000001 (a Smith).
PORTAL_EMPRESA_ID=

# Sim/vazio -- controla se o cookie de sessao do painel e do Portal so
# trafega em HTTPS (SESSION_COOKIE_SECURE). Deixe vazio enquanto os dois
# rodarem em HTTP puro (127.0.0.1) -- ligar sem HTTPS de verdade na
# frente quebra o login, porque o navegador nao manda o cookie de volta.
# So colocar "Sim" quando houver HTTPS real na frente dos dois apps.
COOKIE_HTTPS=

# Pasta onde core/db/backup.py grava o backup diario (banco + documentos
# recebidos). Vazio = uma pasta "backups/" dentro do proprio projeto, no
# MESMO disco -- protege contra exclusao/corrupcao acidental do arquivo
# em uso, mas nao contra falha fisica do disco. Para backup de verdade,
# aponte para um local fora desta maquina (pasta sincronizada com nuvem,
# unidade de rede, HD externo).
BACKUP_DIR=

# Quantos backups diarios manter antes de apagar o mais antigo. Vazio =
# 14 (duas semanas).
BACKUP_MANTER_ULTIMOS=

# Cópia diária do backup de PRODUÇÃO no Google Drive (integracoes/google_drive.py).
# Token gerado por `python -m integracoes.drive_autorizar`. No Railway:
# ERP_DRIVE_TOKEN_PATH=/data/drive_token.json, e o conteúdo do token em
# ERP_DRIVE_TOKEN_JSON (vira o arquivo na primeira rodada). Vazio = sem cópia.
ERP_DRIVE_TOKEN_PATH=
ERP_DRIVE_TOKEN_JSON=
